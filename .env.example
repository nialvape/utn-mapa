# Mismo proyecto de Supabase que utn-mcp-web (cuentas compartidas). La publishable key es pública: protege RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Lectura de fotos de cartelera (solo servidor; en Vercel van como variables secretas).
# Gratuitos de OpenRouter primero; el AI Gateway de Vercel es el último respaldo
# (en Vercel usa el token OIDC del deploy, en local necesita la clave).
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=
# Opcionales, para cambiar de modelo sin tocar código:
# LECTOR_MODELOS_OPENROUTER=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free
# LECTOR_MODELO_GATEWAY=google/gemini-2.5-flash-lite
